# توکن بات از @BotFather
BOT_TOKEN=123456789:replace-me

# آی‌دی عددی تلگرام خودت (از @userinfobot بگیر). چند نفر => با کاما جدا کن.
# فقط همین کاربرها می‌تونن بات رو کنترل کنن؛ بقیه نادیده گرفته می‌شن.
OWNER_IDS=111111111

# کانال اصلی موزیک‌ها (آی‌دی عددی، شروع با -100)
SOURCE_CHANNEL_ID=-1001111111111

# کانال خالی پلی‌لیست (آی‌دی عددی، شروع با -100)
PLAYLIST_CHANNEL_ID=-1002222222222

# اختیاری
# DB_PATH=/data/playlist.db
# SEND_DELAY=1.0          # فاصله (ثانیه) بین ارسال دو موزیک به کانال پلی‌لیست
# MAX_PLAYLIST_SIZE=500   # سقف تعداد موزیک در یک پلی‌لیست
# LOG_LEVEL=INFO
